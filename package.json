{
  "name": "searchapi-ai-sdk",
  "version": "0.1.0",
  "description": "SearchApi tools for the AI SDK: Google web, news, scholar, shopping, maps, flights and hotels as agent tools.",
  "keywords": [
    "ai",
    "ai-sdk",
    "vercel-ai-sdk",
    "agent",
    "tools",
    "search",
    "serp",
    "google",
    "searchapi"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:live": "tsx test/live.ts",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "peerDependencies": {
    "ai": "^6.0.0 || ^7.0.0",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "ai": "^7.0.107",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "zod": "^4.6.5"
  },
  "engines": {
    "node": ">=18"
  }
}
